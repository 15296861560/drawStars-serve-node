# 复制为 NAS 上的 .env 后修改

# 镜像（一般用默认即可）
# API_IMAGE=ghcr.io/15296861560/drawstars-api:latest
# WEB_IMAGE=ghcr.io/15296861560/drawstars-web:latest

# ---------- MySQL 模式 ----------
# external：直连 NAS 已有 MySQL（默认，不启动本 stack 的 mysql）
# bundled ：随后端一起部署 mysql 容器
MYSQL_MODE=external

# bundled 时取消下一行注释（或启动时加 --profile with-mysql）
# COMPOSE_PROFILES=with-mysql

# 连接信息（两种模式都要填账号库名；external 时 MYSQL_HOST 必填）
# external 示例：宿主机 IP / 网关 172.17.0.1 / 已有 MySQL 容器名（需加入同一网络）
# bundled  示例：mysql（compose 服务名，配合 COMPOSE_PROFILES=with-mysql）
MYSQL_HOST=172.17.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=draw_stars
MYSQL_USER=drawStars
MYSQL_PASSWORD=Admin_123

# 仅 bundled 模式需要：
MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_HOST_PORT=3306
# 若 MySQL 在其它 Docker 网络，可在 docker-compose.yml 中启用 mysql_net
# MYSQL_EXTERNAL_NETWORK=your-mysql-network

# 可选：完整 Prisma URL（设置后优先生效；留空则按 MYSQL_* 拼接）
# DATABASE_URL=mysql://drawStars:Admin_123@172.17.0.1:3306/draw_stars

# Redis
REDIS_HOST_PORT=6379

# 后端 release 默认端口（容器内）；宿主映射可用 *_HOST_PORT 覆盖
SERVE_PORT=8010
WS_PORT=8020
NOTIFY_PORT=8030
SERVE_HOST_PORT=8010
WS_HOST_PORT=8020
NOTIFY_HOST_PORT=8030

# 前端站点宿主端口（勿用 80：绿联 NAS 管理页通常占用 80）
WEB_HOST_PORT=8088

# Nginx 反代上游（compose 内服务名:容器端口）
API_UPSTREAM=api:8010

# Watchtower Webhook
WATCHTOWER_HTTP_API_TOKEN=please_change_to_a_long_random_string
WATCHTOWER_HOST_PORT=8080
# WATCHTOWER_IMAGE=containrrr/watchtower:1.7.1
# 若仍报 Docker API 版本问题，可试：DOCKER_API_VERSION=1.41

# TOKEN_VERIFY=true

# 私有 GHCR 镜像首次需在 NAS 登录：
# echo <GITHUB_PAT> | docker login ghcr.io -u <GITHUB_USER> --password-stdin
# PAT 需含 read:packages
