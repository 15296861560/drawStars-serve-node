generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AppInfo {
  appName        String  @id @map("app_name") @db.VarChar(255)
  appId          String? @map("app_id") @db.VarChar(255)
  appCertificate String? @map("app_certificate") @db.Text
  appVersion     String? @default("draw_starts_1.0.0") @map("app_version") @db.VarChar(255)

  @@map("app_info")
}

model User {
  id                BigInt   @id @default(autoincrement())
  name              String?  @default("") @db.VarChar(64)
  password          String?  @db.VarChar(255)
  createTime        BigInt?  @map("createTime")
  updateTime        BigInt?  @map("updateTime")
  level             Int?
  phone             String?  @unique @db.VarChar(20)
  email             String?  @unique @db.VarChar(128)
  accountAlias      String?  @map("account_alias") @db.VarChar(64)
  gender            String?  @db.Char(10)
  introduction      String?  @db.VarChar(255)
  birthday          String?  @db.VarChar(64)
  region            String?  @db.VarChar(255)
  avatar            String?  @db.VarChar(255)
  status            String?  @default("active") @db.VarChar(32)
  smsLoginEnabled   Boolean? @default(true) @map("sms_login_enabled")
  oauthLoginEnabled Boolean? @default(true) @map("oauth_login_enabled")
  deletedAt         BigInt?  @map("deleted_at")
  notifyPref        UserNotifyPref?
  userRoles         SysUserRole[]

  @@map("user")
}

/// RBAC 角色
model SysRole {
  id         BigInt        @id @default(autoincrement())
  name       String        @db.VarChar(64)
  code       String        @unique @db.VarChar(64)
  remark     String?       @db.VarChar(255)
  status     Int           @default(1) @db.TinyInt
  sort       Int           @default(0)
  createTime BigInt?       @map("create_time")
  updateTime BigInt?       @map("update_time")
  userRoles  SysUserRole[]
  roleMenus  SysRoleMenu[]

  @@map("sys_role")
}

/// RBAC 菜单（目录 / 菜单 / 按钮）
model SysMenu {
  id         BigInt        @id @default(autoincrement())
  parentId   BigInt        @default(0) @map("parent_id")
  name       String        @db.VarChar(64)
  type       Int           @db.TinyInt
  path       String?       @db.VarChar(255)
  component  String?       @db.VarChar(255)
  permission String?       @db.VarChar(128)
  icon       String?       @db.VarChar(64)
  client     String?       @default("pc") @db.VarChar(32)
  moduleCode String?       @map("module_code") @db.VarChar(64)
  isTab      Int?          @default(0) @map("is_tab") @db.TinyInt
  sort       Int           @default(0)
  visible    Int           @default(1) @db.TinyInt
  status     Int           @default(1) @db.TinyInt
  createTime BigInt?       @map("create_time")
  updateTime BigInt?       @map("update_time")
  roleMenus  SysRoleMenu[]

  @@index([parentId])
  @@index([client])
  @@map("sys_menu")
}

model SysUserRole {
  userId BigInt  @map("user_id")
  roleId BigInt  @map("role_id")
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   SysRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("sys_user_role")
}

model SysRoleMenu {
  roleId BigInt  @map("role_id")
  menuId BigInt  @map("menu_id")
  role   SysRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu   SysMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@map("sys_role_menu")
}

model UserNotifyPref {
  userId       BigInt  @id @map("user_id")
  inApp        Boolean @default(true) @map("in_app")
  sms          Boolean @default(false)
  email        Boolean @default(false)
  websocket    Boolean @default(true)
  updateTime   BigInt? @map("update_time")
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notify_pref")
}

model OauthInfo {
  platform   String @db.VarChar(64)
  userId     BigInt @map("user_id")
  openId     String @map("open_id") @db.VarChar(255)
  createTime BigInt? @map("create_time")
  updateTime BigInt? @map("update_time")

  @@id([platform, userId])
  @@map("oauth_info")
}

model Log {
  logId       BigInt  @id @default(autoincrement()) @map("log_id")
  logType     String? @map("log_type") @db.VarChar(32)
  content     String? @db.Text
  hostname    String? @db.VarChar(255)
  originalUrl String? @db.VarChar(255)
  createTime  BigInt? @map("createTime")

  // 日志查询（WHERE logType ORDER BY logId DESC）在 500w+ 行表上必须走索引，否则全表扫描导致接口超时
  @@index([logType, logId], map: "idx_log_type_log_id")
  @@map("log")
}

model Notify {
  id         BigInt  @id @default(autoincrement()) @map("notifyI_id")
  createTime BigInt? @map("create_time")
  updateTime BigInt? @map("update_time")
  createBy   BigInt? @map("create_by")
  updateBy   BigInt? @map("update_by")
  notifyType String? @map("notify_type") @db.VarChar(64)
  notifyMsg  Bytes?  @map("notify_msg")
  sendId     BigInt? @map("send_id")
  receiveId  BigInt? @map("receive_id")
  isRead     Boolean @default(false) @map("is_read")

  @@index([receiveId, isRead])
  @@index([receiveId, createTime])
  @@map("notify")
}

/// 通知公告（管理端发布）
model Notice {
  id         BigInt  @id @default(autoincrement())
  title      String  @db.VarChar(200)
  content    String? @db.LongText
  type       String? @default("rich") @db.VarChar(32)
  icon       String? @db.VarChar(255)
  status     String? @default("draft") @db.VarChar(32)
  createTime BigInt? @map("create_time")
  updateTime BigInt? @map("update_time")

  @@index([title])
  @@index([type])
  @@index([status])
  @@map("notice")
}

model Province {
  id       Int     @id @default(autoincrement()) @db.UnsignedInt
  code     BigInt?
  name     String? @db.VarChar(32)
  province String? @db.VarChar(32)
  city     String? @db.VarChar(32)
  area     String? @db.VarChar(32)
  town     String? @db.VarChar(32)

  @@map("province")
}

model Pageview {
  viewId    Int       @id @map("view_id")
  createTime DateTime? @map("create_time")
  userId    Int?      @map("user_id")
  ipv4      String?   @db.VarChar(64)
  language  String?   @db.VarChar(64)
  system    String?   @db.VarChar(255)
  hostname  String?   @db.VarChar(255)
  browser   String?   @db.VarChar(64)
  equipment String?   @db.VarChar(255)

  @@map("pageview")
}

/// Umami 风格网站配置
model AnalyticsWebsite {
  websiteId   Int       @id @default(autoincrement()) @map("website_id")
  websiteUuid String    @unique @map("website_uuid") @db.VarChar(36)
  name        String    @db.VarChar(100)
  domain      String?   @db.VarChar(500)
  shareId     String?   @unique @map("share_id") @db.VarChar(64)
  createdAt   DateTime? @default(now()) @map("created_at")
  sessions    AnalyticsSession[]
  pageviews   AnalyticsPageview[]

  @@map("analytics_website")
}

/// Umami 风格访客会话
model AnalyticsSession {
  sessionId   Int       @id @default(autoincrement()) @map("session_id")
  sessionUuid String    @unique @map("session_uuid") @db.VarChar(36)
  websiteId   Int       @map("website_id")
  createdAt   DateTime? @default(now()) @map("created_at")
  hostname    String?   @db.VarChar(100)
  browser     String?   @db.VarChar(20)
  os          String?   @db.VarChar(20)
  device      String?   @db.VarChar(20)
  screen      String?   @db.VarChar(11)
  language    String?   @db.VarChar(35)
  country     String?   @db.VarChar(2)
  website     AnalyticsWebsite @relation(fields: [websiteId], references: [websiteId], onDelete: Cascade)
  pageviews   AnalyticsPageview[]

  @@index([websiteId, createdAt])
  @@map("analytics_session")
}

/// Umami 风格页面访问
model AnalyticsPageview {
  viewId    Int       @id @default(autoincrement()) @map("view_id")
  websiteId Int       @map("website_id")
  sessionId Int       @map("session_id")
  createdAt DateTime? @default(now()) @map("created_at")
  url       String    @db.VarChar(500)
  referrer  String?   @db.VarChar(500)
  title     String?   @db.VarChar(255)
  website   AnalyticsWebsite @relation(fields: [websiteId], references: [websiteId], onDelete: Cascade)
  session   AnalyticsSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([websiteId, createdAt])
  @@index([websiteId, sessionId, createdAt])
  @@map("analytics_pageview")
}

model WebAdress {
  id         BigInt  @id @default(autoincrement())
  name       String? @db.VarChar(64)
  address    String? @db.VarChar(255)
  createTime BigInt? @map("create_time")
  updateTime BigInt? @map("update_time")
  type       String? @db.VarChar(64)
  icon       String? @db.VarChar(255)
  openWay    String? @map("open_way") @db.VarChar(32)

  @@map("web_adress")
}

model AiConversation {
  id        String      @id @default(uuid()) @db.VarChar(36)
  userKey   String      @map("user_key") @db.VarChar(64)
  title     String      @default("新对话") @db.VarChar(128)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  messages  AiMessage[]

  @@index([userKey, updatedAt])
  @@map("ai_conversation")
}

model AiMessage {
  id             String         @id @default(uuid()) @db.VarChar(36)
  conversationId String         @map("conversation_id") @db.VarChar(36)
  role           String         @db.VarChar(16)
  type           String         @default("text") @db.VarChar(16)
  content        String         @db.Text
  payload        Json?
  capabilityId   String?        @map("capability_id") @db.VarChar(32)
  createdAt      DateTime       @default(now()) @map("created_at")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_message")
}

/// 应用管理（产品/安装包目录，区别于 app_info 凭证配置）
model AppManage {
  id              BigInt  @id @default(autoincrement())
  name            String  @db.VarChar(128)
  description     String? @db.VarChar(500)
  version         String? @db.VarChar(64)
  status          String? @default("draft") @db.VarChar(32)
  icon            String? @db.VarChar(255)
  category        String? @db.VarChar(64)
  filePath        String? @map("file_path") @db.Text
  moduleCode      String? @map("module_code") @db.VarChar(64)
  platforms       String? @db.VarChar(255)
  moduleUrl       String? @map("module_url") @db.VarChar(512)
  checksum        String? @db.VarChar(128)
  releaseNotes    String? @map("release_notes") @db.VarChar(1000)
  forceUpdate     Int?    @default(0) @map("force_update") @db.TinyInt
  minShellVersion String? @map("min_shell_version") @db.VarChar(32)
  createTime      BigInt? @map("create_time")
  updateTime      BigInt? @map("update_time")

  @@index([name])
  @@index([status])
  @@index([category])
  @@index([moduleCode])
  @@map("app_manage")
}

/// 积分账户
model PointsAccount {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId          BigInt   @map("user_id") @db.UnsignedBigInt
  pointsType      String   @default("GENERAL") @map("points_type") @db.VarChar(32)
  availablePoints Int      @default(0) @map("available_points")
  frozenPoints    Int      @default(0) @map("frozen_points")
  totalEarned     Int      @default(0) @map("total_earned")
  totalSpent      Int      @default(0) @map("total_spent")
  level           Int      @default(1) @db.TinyInt
  levelName       String   @default("普通会员") @map("level_name") @db.VarChar(32)
  status          String   @default("ACTIVE") @db.VarChar(16)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  transactions PointsTransaction[]

  @@unique([userId, pointsType], map: "uk_user_points_type")
  @@index([userId], map: "idx_user_id")
  @@index([status], map: "idx_status")
  @@map("points_account")
}

/// 积分交易记录
model PointsTransaction {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  transactionNo String    @unique(map: "uk_transaction_no") @map("transaction_no") @db.VarChar(32)
  userId        BigInt    @map("user_id") @db.UnsignedBigInt
  accountId     BigInt    @map("account_id") @db.UnsignedBigInt
  type          String    @db.VarChar(16)
  points        Int
  balanceBefore Int       @map("balance_before")
  balanceAfter  Int       @map("balance_after")
  source        String    @db.VarChar(32)
  referenceId   String?   @map("reference_id") @db.VarChar(64)
  referenceType String?   @map("reference_type") @db.VarChar(32)
  description   String    @db.VarChar(255)
  expireAt      DateTime? @map("expire_at")
  status        String    @default("COMPLETED") @db.VarChar(16)
  extraData     Json?     @map("extra_data")
  createdAt     DateTime  @default(now()) @map("created_at")

  account PointsAccount @relation(fields: [accountId], references: [id])

  @@index([userId], map: "idx_user_id")
  @@index([accountId], map: "idx_account_id")
  @@index([type], map: "idx_type")
  @@index([source], map: "idx_source")
  @@index([referenceType, referenceId], map: "idx_reference")
  @@index([status], map: "idx_status")
  @@index([createdAt], map: "idx_created_at")
  @@index([expireAt], map: "idx_expire_at")
  @@map("points_transaction")
}

/// 积分规则
model PointsRule {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(64)
  code        String    @unique(map: "uk_code") @db.VarChar(32)
  source      String    @db.VarChar(32)
  pointsType  String    @default("GENERAL") @map("points_type") @db.VarChar(32)
  pointsValue Decimal   @map("points_value") @db.Decimal(10, 4)
  calcMethod  String    @default("FIXED") @map("calc_method") @db.VarChar(16)
  dailyLimit  Int       @default(0) @map("daily_limit")
  monthlyLimit Int      @default(0) @map("monthly_limit")
  singleLimit Int       @default(0) @map("single_limit")
  validDays   Int       @default(365) @map("valid_days")
  description String?   @db.VarChar(255)
  enabled     Int       @default(1) @db.TinyInt
  priority    Int       @default(0)
  startTime   DateTime? @map("start_time")
  endTime     DateTime? @map("end_time")
  extraConfig Json?     @map("extra_config")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([source], map: "idx_source")
  @@index([enabled], map: "idx_enabled")
  @@index([priority], map: "idx_priority")
  @@map("points_rule")
}

/// 积分等级配置
model PointsLevel {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  level          Int      @unique(map: "uk_level") @db.TinyInt
  name           String   @db.VarChar(32)
  icon           String?  @db.VarChar(32)
  requiredPoints Int      @map("required_points")
  benefits       Json?
  description    String?  @db.VarChar(255)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([requiredPoints], map: "idx_required_points")
  @@map("points_level")
}

/// 签到记录
model PointsCheckIn {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId          BigInt   @map("user_id") @db.UnsignedBigInt
  checkInDate     DateTime @map("check_in_date") @db.Date
  pointsEarned    Int      @map("points_earned")
  consecutiveDays Int      @default(1) @map("consecutive_days")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([userId, checkInDate], map: "uk_user_date")
  @@index([userId], map: "idx_user_id")
  @@index([checkInDate], map: "idx_check_in_date")
  @@map("points_check_in")
}

/// 用户积分限制记录
model PointsUserLimit {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt   @map("user_id") @db.UnsignedBigInt
  ruleCode   String   @map("rule_code") @db.VarChar(32)
  periodType String   @map("period_type") @db.VarChar(16)
  periodKey  String   @map("period_key") @db.VarChar(16)
  count      Int      @default(0)
  points     Int      @default(0)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, ruleCode, periodType, periodKey], map: "uk_user_rule_period")
  @@index([userId], map: "idx_user_id")
  @@index([periodKey], map: "idx_period_key")
  @@map("points_user_limit")
}

/// 问卷
model Survey {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title           String    @db.VarChar(200)
  description     String?   @db.Text
  type            String    @default("normal") @db.VarChar(32)
  status          String    @default("draft") @db.VarChar(32)
  creatorId       BigInt    @map("creator_id") @db.UnsignedBigInt
  coverImage      String?   @map("cover_image") @db.VarChar(500)
  themeConfig     Json?     @map("theme_config")
  settings        Json?
  scoringEnabled  Boolean   @default(false) @map("scoring_enabled")
  scoringConfig   Json?     @map("scoring_config")
  scoringRules    Json?     @map("scoring_rules")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  questions       SurveyQuestion[]
  logicRules      SurveyLogicRule[]
  publishConfig   SurveyPublishConfig?
  responses       SurveyResponse[]
  scoringResults  SurveyScoringResult[]
  snapshots       SurveyStatisticsSnapshot[]
  exportTasks     SurveyExportTask[]
  reportViews     SurveyReportView[]

  @@index([creatorId], map: "idx_survey_creator")
  @@index([status], map: "idx_survey_status")
  @@index([deletedAt], map: "idx_survey_deleted")
  @@map("survey")
}

/// 问卷题目
model SurveyQuestion {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  surveyId    BigInt   @map("survey_id") @db.UnsignedBigInt
  type        String   @db.VarChar(32)
  title       String   @db.Text
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  pageIndex   Int      @default(1) @map("page_index")
  required    Boolean  @default(false)
  config      Json?
  extra       Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  survey  Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options SurveyOption[]
  answers SurveyAnswer[]

  @@index([surveyId], map: "idx_question_survey")
  @@index([sortOrder], map: "idx_question_sort")
  @@map("survey_question")
}

/// 题目选项
model SurveyOption {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  questionId BigInt   @map("question_id") @db.UnsignedBigInt
  content    String   @db.VarChar(500)
  sortOrder  Int      @default(0) @map("sort_order")
  isOther    Boolean  @default(false) @map("is_other")
  config     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId], map: "idx_option_question")
  @@map("survey_option")
}

/// 逻辑规则
model SurveyLogicRule {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  surveyId          BigInt   @map("survey_id") @db.UnsignedBigInt
  sourceQuestionId  BigInt   @map("source_question_id") @db.UnsignedBigInt
  condition         Json
  actionType        String   @map("action_type") @db.VarChar(32)
  targetQuestionId  BigInt?  @map("target_question_id") @db.UnsignedBigInt
  targetPage        Int?     @map("target_page")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId], map: "idx_logic_survey")
  @@map("survey_logic_rule")
}

/// 发布配置
model SurveyPublishConfig {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  surveyId       BigInt    @unique @map("survey_id") @db.UnsignedBigInt
  publishTime    DateTime? @map("publish_time")
  expireTime     DateTime? @map("expire_time")
  maxResponses   Int?      @map("max_responses")
  limitPerUser   Int       @default(0) @map("limit_per_user")
  requireLogin   String    @default("none") @map("require_login") @db.VarChar(16)
  accessPassword String?   @map("access_password") @db.VarChar(50)
  ipLimit        Int       @default(0) @map("ip_limit")
  deviceLimit    Int       @default(0) @map("device_limit")
  minDuration    Int       @default(0) @map("min_duration")
  shareCode      String    @unique @map("share_code") @db.VarChar(20)
  clickCount     Int       @default(0) @map("click_count")
  whitelist      Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@map("survey_publish_config")
}

/// 回收记录
model SurveyResponse {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  surveyId      BigInt    @map("survey_id") @db.UnsignedBigInt
  userId        BigInt?   @map("user_id") @db.UnsignedBigInt
  status        String    @default("draft") @db.VarChar(32)
  isValid       Boolean   @default(true) @map("is_valid")
  invalidReason String?   @map("invalid_reason") @db.VarChar(200)
  duration      Int       @default(0)
  ip            String?   @db.VarChar(50)
  deviceInfo    Json?     @map("device_info")
  deviceFingerprint String? @map("device_fingerprint") @db.VarChar(128)
  source        String?   @db.VarChar(100)
  attemptNumber Int       @default(1) @map("attempt_number")
  draftData     Json?     @map("draft_data")
  submittedAt   DateTime? @map("submitted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  survey        Survey               @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers       SurveyAnswer[]
  scoringResult SurveyScoringResult?

  @@index([surveyId], map: "idx_response_survey")
  @@index([userId], map: "idx_response_user")
