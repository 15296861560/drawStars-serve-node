  isMuted        Boolean  @default(false) @map("is_muted")
  lastReadSeq    BigInt   @default(0) @map("last_read_seq")
  draft          String?  @db.Text
  deletedAt      BigInt?  @map("deleted_at")
  updatedAt      BigInt?  @map("updated_at")

  conversation ImConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId], map: "uk_im_conv_user")
  @@index([userId], map: "idx_im_conv_user_user")
  @@map("im_conversation_user")
}

/// 消息
model ImMessage {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  msgId          String   @unique(map: "uk_im_msg_id") @map("msg_id") @db.VarChar(64)
  clientMsgId    String   @map("client_msg_id") @db.VarChar(64)
  conversationId BigInt   @map("conversation_id") @db.UnsignedBigInt
  senderId       BigInt   @map("sender_id") @db.UnsignedBigInt
  msgType        String   @map("msg_type") @db.VarChar(16)
  content        Json?
  seq            BigInt   @default(0)
  status         String   @default("NORMAL") @db.VarChar(16)
  serverTime     BigInt   @map("server_time")
  atUserIds      Json?    @map("at_user_ids")
  atAll          Boolean  @default(false) @map("at_all")

  @@unique([senderId, clientMsgId], map: "uk_im_msg_sender_client")
  @@index([conversationId, seq], map: "idx_im_msg_conv_seq")
  @@index([conversationId, status], map: "idx_im_msg_conv_status")
  @@index([senderId], map: "idx_im_msg_sender")
