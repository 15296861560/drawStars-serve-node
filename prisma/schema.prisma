  gender           String   @default("UNKNOWN") @db.VarChar(16)
  tags             Json?
  allowStrangerMsg Boolean  @default(false) @map("allow_stranger_msg")
  showOnline       Boolean  @default(true) @map("show_online")
  status           String   @default("OFFLINE") @db.VarChar(16)
  extra            Json?
  updatedAt        BigInt?  @map("updated_at")

  @@map("im_user_profile")
}

/// 会话
model ImConversation {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  convType    String   @map("conv_type") @db.VarChar(16)
  bizId       String   @map("biz_id") @db.VarChar(64)
  pairKey     String?  @map("pair_key") @db.VarChar(129)
  lastMsgId   String?  @map("last_msg_id") @db.VarChar(64)
