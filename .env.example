# MySQL connection URL for Prisma（未设置时会按 publish-config / 下方 MYSQL_* 自动拼）
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://drawStars:Admin_123@localhost:3306/draw_stars"

# release 默认端口（可覆盖）：SERVE 8010 / WS 8020 / NOTIFY 8030 / REDIS 6379
# NODE_ENV=production
# SERVE_PORT=8010
# WS_PORT=8020
# NOTIFY_PORT=8030
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=drawStars
# MYSQL_PASSWORD=Admin_123
# MYSQL_DATABASE=draw_stars
# UPLOAD_DIR=/app/uploadDir

# 设为 true 才开启接口 token 校验（默认关闭，与历史行为一致）
# TOKEN_VERIFY=true

# AI 助手密钥与参数从 app_info 表读取（勿写在本文件）：
#
# | app_name      | app_id              | app_certificate        | app_version              |
# |---------------|---------------------|------------------------|--------------------------|
# | openai        | 模型，如 gpt-4o-mini | API Key（sk-...）       | OpenAI 兼容 Base URL（可选） |
# | ai_assistant  | 上传大小上限 MB，默认 10 | 系统提示词（Text，可选） | —                        |
#
# 示例 SQL：
# INSERT INTO app_info (app_name, app_id, app_certificate, app_version)
# VALUES ('openai', 'gpt-4o-mini', 'sk-your-key', 'https://api.openai.com/v1');
# INSERT INTO app_info (app_name, app_id, app_certificate)
# VALUES ('ai_assistant', '10', '你是 DrawStars 助手…');
#
# 其它能力同样在 app_info：
# - baidu_translate：app_id + app_certificate（翻译）
# - baidu_map：app_certificate 为地图 AK（天气）

# 首次启用持久化会话：
# npx prisma db push
