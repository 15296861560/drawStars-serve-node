# MySQL connection URL for Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://drawStars:Admin_123@192.168.1.3:44925/draw_stars"

# 设为 true 才开启接口 token 校验（默认关闭，与历史行为一致）
# TOKEN_VERIFY=true

# AI 助手密钥与参数从 app_info 表读取（勿写在本文件）：
#
# | app_name      | app_id              | app_certificate        | app_version              |
# |---------------|---------------------|------------------------|--------------------------|
# | openai        | 模型，如 gpt-4o-mini | API Key（sk-...）       | OpenAI 兼容 Base URL（可选） |
# | ai_assistant  | 上传大小上限 MB，默认 10 | 系统提示词（Text，可选） | —                        |
#
# 示例 SQL：
# INSERT INTO app_info (app_name, app_id, app_certificate, app_version)
# VALUES ('openai', 'gpt-4o-mini', 'sk-your-key', 'https://api.openai.com/v1');
# INSERT INTO app_info (app_name, app_id, app_certificate)
# VALUES ('ai_assistant', '10', '你是 DrawStars 助手…');
#
# 其它能力同样在 app_info：
# - baidu_translate：app_id + app_certificate（翻译）
# - baidu_map：app_certificate 为地图 AK（天气）

# 首次启用持久化会话：
# npx prisma db push
