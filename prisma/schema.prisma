  textContent  String?  @map("text_content") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId], map: "uk_answer_response_question")
  @@index([questionId], map: "idx_answer_question")
  @@map("survey_answer")
}

/// 评分结果
model SurveyScoringResult {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  responseId  BigInt    @unique @map("response_id") @db.UnsignedBigInt
  surveyId    BigInt    @map("survey_id") @db.UnsignedBigInt
