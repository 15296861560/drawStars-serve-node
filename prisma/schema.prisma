  logisticsCompany String?  @map("logistics_company") @db.VarChar(64)
  trackingNo       String?  @map("tracking_no") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  instance TaskInstance @relation(fields: [instanceId], references: [id])
  task     TaskDef      @relation(fields: [taskId], references: [id])

  @@unique([instanceId, itemName], map: "uk_task_claim_instance_item")
  @@index([userId], map: "idx_task_claim_user")
  @@index([taskId], map: "idx_task_claim_task")
  @@index([status], map: "idx_task_claim_status")
  @@map("task_reward_claim")
}

/// Task notification
